{
  "name": "orb",
  "version": "1.0.0",
  "description": "Monorepo for premake-ts and orb build tools",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "node --experimental-strip-types --disable-warning=DEP0190 packages/premake-ts/src/main.ts",
    "parse": "node --experimental-strip-types --disable-warning=DEP0190 packages/premake-ts-generator/src/main.ts",
    "orb": "node --experimental-strip-types --disable-warning=DEP0190 packages/build/src/main.ts",
    "vitest": "vitest"
  },
  "keywords": [
    "premake",
    "typescript",
    "build"
  ],
  "author": "Tom Yaxley",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.2"
  }
}
