{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022"],
		"strict": true,
		"skipLibCheck": true,
		"declaration": true,
		"emitDeclarationOnly": true,
		"outDir": "../../types/intermediate",
		"forceConsistentCasingInFileNames": true
	},
	"include": [
		"../scopes/scopes.ts",
		"../scopes/generated/**/*",
		"../generator/index.ts"
	]
}