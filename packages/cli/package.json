{
  "name": "premake-ts",
  "version": "1.0.0",
  "description": "Write Premake build scripts in TypeScript with full type safety and editor completion",
  "type": "module",
  "main": "src/main.ts",
  "bin": {
    "premake-ts": "bin/cli.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./generator": "./src/generator.ts",
    "./util": "./src/util.ts",
    "./PremakeScope": "./src/PremakeScope.ts",
    "./data/fields.json": "./data/fields.json"
  },
  "files": [
    "bin/",
    "src/",
    "types/",
    "data/"
  ],
  "engines": {
    "node": ">=22.6.0"
  },
  "keywords": [
    "premake",
    "typescript",
    "build"
  ],
  "author": "Tom Yaxley",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tommitytom/premake-ts.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/tommitytom/premake-ts",
  "bugs": "https://github.com/tommitytom/premake-ts/issues"
}
