{
  "name": "premake-ts",
  "version": "1.0.6",
  "description": "Write Premake build scripts in TypeScript with full type safety and editor completion",
  "type": "module",
  "main": "dist/main.js",
  "bin": {
    "premake-ts": "bin/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/dump-globals.lua dist/"
  },
  "exports": {
    ".": "./dist/index.js",
    "./generator": "./dist/generator.js",
    "./util": "./dist/util.js",
    "./PremakeScope": "./dist/PremakeScope.js",
    "./data/fields.json": "./data/fields.json"
  },
  "files": [
    "bin/",
    "dist/",
    "types/",
    "data/"
  ],
  "engines": {
    "node": ">=22.6.0"
  },
  "keywords": [
    "premake",
    "typescript",
    "build"
  ],
  "author": "Tom Yaxley",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tommitytom/premake-ts.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/tommitytom/premake-ts",
  "bugs": "https://github.com/tommitytom/premake-ts/issues",
  "devDependencies": {
    "@types/node": "^24.10.1"
  }
}
