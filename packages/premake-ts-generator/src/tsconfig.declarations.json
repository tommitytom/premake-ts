{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022"],
		"strict": true,
		"skipLibCheck": true,
		"declaration": true,
		"emitDeclarationOnly": true,
		"outDir": "../../premake-ts/types/intermediate",
		"forceConsistentCasingInFileNames": true
	},
	"include": [
		"../../premake-ts/src/scopes/scopes.ts",
		"../../premake-ts/src/scopes/generated/**/*",
		"../../premake-ts/src/index.ts"
	]
}